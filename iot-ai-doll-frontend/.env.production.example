# Admin 前端环境变量示例
# ──────────────────────────────────────
# 用法: 复制本文件为 .env.production, 改 VITE_CLAIM_URL_BASE
# cp .env.production.example .env.production
# vim .env.production  # 改 URL
# npm run build        # 重新 build (env 在 build 时注入到代码里)
#
# 为什么不直接 commit .env.production:
# - .gitignore 排除了, 避免敏感信息入库
# - 每台服务器 / 每次迁移都要改, 走 cp + vim 流程更清楚
# ──────────────────────────────────────

# 玩偶认领 URL 前缀 (H5 入口)
# 拼出完整 URL: ${VITE_CLAIM_URL_BASE}${activation_code}
# 例: https://soa.laziestlife.com/epet/?code=l_8IjTYgxOAl_pVcs2Y
#
# 当前源服 (2026-07-28): https://soa.laziestlife.com/epet/?code=
# 迁移后目标域名:        https://dw.momotoy.fun/epet/?code=
# 注: query 参数于 2026-07-28 由 ?id= 改为 ?code=, 命名铁律见 memory 21
# 注: 目标域名于 2026-07-28 由 .tech 改为 .fun, 域名规划见 memory 13
VITE_CLAIM_URL_BASE=https://soa.laziestlife.com/epet/?code=
